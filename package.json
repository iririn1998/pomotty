{
  "name": "pomotty",
  "version": "1.0.0",
  "description": "",
  "keywords": [],
  "license": "ISC",
  "author": "",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "build": "rolldown -c rolldown.config.mjs",
    "start": "pnpm build && node dist/cli.js",
    "lint": "oxlint . --deny-warnings --report-unused-disable-directives-severity=error",
    "lint:fix": "oxlint . --fix --deny-warnings --report-unused-disable-directives-severity=error",
    "format": "oxfmt --write",
    "format:check": "oxfmt --check",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "oxfmt": "^0.61.0",
    "oxlint": "^1.76.0",
    "rolldown": "^1.2.3",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "onFail": "error"
    }
  }
}
